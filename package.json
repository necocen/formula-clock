{
  "name": "formula-clock-stix2",
  "version": "6.0.0",
  "private": true,
  "description": "A mathematical clock with persistent digits, switchable typography, and AST data providers",
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm run lint --fix",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "build": "pnpm run typecheck && tsx tools/build.ts",
    "build:external": "pnpm run typecheck && tsx tools/build.ts --external",
    "generate:licenses": "pnpm run typecheck && tsx tools/licenses.ts",
    "generate": "pnpm run typecheck && tsx tools/generate.ts",
    "test": "pnpm run check && vitest run --project unit --project build",
    "test:og": "pnpm run typecheck && vitest run --project og",
    "deploy": "wrangler deploy",
    "preview": "wrangler versions upload",
    "typecheck": "tsc --noEmit",
    "import:data": "pnpm run typecheck && tsx tools/import-data.ts",
    "dev": "wrangler dev --local",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:browser": "playwright test",
    "test:watch": "vitest --project unit"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@mathjax/mathjax-euler-font-extension": "4.1.3",
    "@mathjax/mathjax-fira-font": "4.1.3",
    "@mathjax/mathjax-modern-font": "4.1.3",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/mathjax-termes-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@playwright/test": "1.62.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "22.20.2",
    "esbuild": "0.28.1",
    "miniflare": "5.20260907.0-alpha",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.129.1"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "download"
    }
  }
}
