{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formula-clock",
  "account_id": "248fba353bf3b6b491cbd10d1d759bde",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./dist-worker/index.mjs",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type":"CompiledWasm","globs":["**/*.wasm"],"fallthrough":false}],
  "build": {"command":"npm run build:external"},
  "observability": {"enabled":true},
  "r2_buckets": [{"binding":"OG_IMAGES","bucket_name":"formula-clock-og","preview_bucket_name":"formula-clock-og-preview"}],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-external",
    "run_worker_first": ["/", "/og.png"],
    "not_found_handling": "none"
  }
}
