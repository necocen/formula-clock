{
  "name": "formula-clock-stix2",
  "version": "6.0.0",
  "private": true,
  "description": "A mathematical clock with persistent digits, switchable typography, and AST data providers",
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "build": "npm run typecheck && tsx tools/build.ts",
    "build:external": "npm run typecheck && tsx tools/build.ts --external",
    "generate": "npm run typecheck && tsx tools/generate.ts",
    "test": "npm run check && npm run test:unit && npm run test:build",
    "test:og": "npm run build:external && node --import tsx --test tests/og/*.test.ts",
    "deploy": "wrangler deploy",
    "preview": "wrangler versions upload",
    "typecheck": "tsc --noEmit",
    "import:data": "npm run typecheck && tsx tools/import-data.ts",
    "dev": "wrangler dev --local",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:build": "node --import tsx --test tests/build/*.test.ts",
    "test:browser": "tsx tools/test-browser.ts"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@mathjax/mathjax-euler-font-extension": "4.1.3",
    "@mathjax/mathjax-fira-font": "4.1.3",
    "@mathjax/mathjax-modern-font": "4.1.3",
    "@mathjax/mathjax-stix2-font": "4.1.3",
    "@mathjax/mathjax-termes-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "22.20.2",
    "esbuild": "0.28.1",
    "miniflare": "5.20260907.0-alpha",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "playwright": "1.62.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  },
  "type": "module"
}
