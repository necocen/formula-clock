{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error"
  },
  "ignorePatterns": [
    "index.html",
    "dist-external/**",
    "dist-worker/**",
    "node_modules/**",
    ".venv/**",
    ".wrangler/**",
    ".playwright-cli/**",
    "test-results/**",
    "data/**"
  ]
}
