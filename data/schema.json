{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formula Clock v1",
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "i", "j"],
          "properties": {
            "op": {
              "const": "lit"
            },
            "i": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "j": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "a"],
          "properties": {
            "op": {
              "enum": ["neg", "sqrt", "fact"]
            },
            "a": {
              "$ref": "#/$defs/expr"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "a", "b"],
          "properties": {
            "op": {
              "enum": ["add", "sub", "mul", "div", "pow"]
            },
            "a": {
              "$ref": "#/$defs/expr"
            },
            "b": {
              "$ref": "#/$defs/expr"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "seconds": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/expr"
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "minutes"],
      "properties": {
        "schema": {
          "const": "formula-clock/1"
        },
        "minutes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:[01][0-9]|2[0-3])[0-5][0-9]$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/seconds"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "hhmm", "seconds"],
      "properties": {
        "schema": {
          "const": "formula-clock/1"
        },
        "hhmm": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3])[0-5][0-9]$"
        },
        "seconds": {
          "$ref": "#/$defs/seconds"
        }
      },
      "additionalProperties": false
    }
  ]
}
